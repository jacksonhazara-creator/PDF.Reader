<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfReader.App.ViewModels"
             xmlns:c="using:PdfReader.App.Controls"
             xmlns:v="using:PdfReader.App.Views"
             xmlns:l="using:PdfReader.App.Localization"
             x:Class="PdfReader.App.Views.DocumentView"
             x:DataType="vm:DocumentViewModel"
             Background="{DynamicResource ViewerBrush}">
  <UserControl.Styles>
    <Style Selector="Rectangle.vsep">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="Fill" Value="{DynamicResource SubtleBorderBrush}" />
    </Style>
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#33000000" />
      <Setter Property="Margin" Value="2,0" />
    </Style>
    <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <!-- Security banner: active content found and blocked -->
    <Border Background="{DynamicResource WarningBackgroundBrush}" Padding="12,8" IsVisible="{Binding IsSecurityBannerVisible}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <c:Icon Data="{StaticResource IconShield}" Foreground="{DynamicResource WarningForegroundBrush}" Margin="0,0,10,0" />
        <TextBlock Grid.Column="1" Text="{Binding SecurityMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="popup" Content="{l:Tr Dismiss}" Command="{Binding DismissSecurityBannerCommand}" />
      </Grid>
    </Border>

    <Panel Grid.Row="1" x:Name="Root">
      <DockPanel x:Name="Dock" LastChildFill="True">
        <c:ToolbarView x:Name="Toolbar" DockPanel.Dock="Left" />
        <v:RightPanel DockPanel.Dock="Right" />

        <Grid RowDefinitions="Auto,*">
          <!-- Options for the active tool -->
          <Border IsVisible="{Binding Main.Markup.HasOptions}" Background="{DynamicResource ChromeBrush}"
                  BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
            <WrapPanel DataContext="{Binding Main.Markup}" x:DataType="vm:MarkupViewModel" LineSpacing="4" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                <c:Icon Data="{Binding Current.Icon}" Width="18" Height="18" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Current.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <Rectangle Classes="vsep" />

              <!-- Marker -->
              <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowMarkerOptions}" VerticalAlignment="Center">
                <Border Width="34" Height="20" CornerRadius="4" Background="White" Margin="0,0,8,0" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                  <Border Background="{Binding MarkerPreview}" CornerRadius="3" />
                </Border>
                <ItemsControl ItemsSource="{Binding MarkerColors}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ColorSwatch">
                      <Button Classes="swatch" Background="{Binding Brush}" ToolTip.Tip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}"
                              Command="{Binding $parent[ItemsControl].((vm:MarkupViewModel)DataContext).SetMarkerColorCommand}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Rectangle Classes="vsep" />
                <TextBlock Classes="label" Text="{l:Tr Transparency}" />
                <Slider Width="100" Minimum="0" Maximum="90" Value="{Binding MarkerTransparency}" VerticalAlignment="Center" AutomationProperties.Name="{l:Tr Transparency}" />
                <TextBlock Classes="value" Text="{Binding MarkerTransparency, StringFormat='{}{0:0}%'}" />
                <TextBlock Classes="label" Text="{l:Tr ColorStrength}" Margin="10,0,8,0" />
                <Slider Width="100" Minimum="20" Maximum="100" Value="{Binding MarkerStrength}" VerticalAlignment="Center" AutomationProperties.Name="{l:Tr ColorStrength}" />
                <TextBlock Classes="value" Text="{Binding MarkerStrength, StringFormat='{}{0:0}%'}" />
              </StackPanel>

              <!-- Comment shapes & color -->
              <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowCommentOptions}" VerticalAlignment="Center">
                <TextBlock Classes="label" Text="{l:Tr Shape}" />
                <ItemsControl ItemsSource="{Binding Shapes}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShapeChoice">
                      <Button Classes="icon small" ToolTip.Tip="{Binding Title}" AutomationProperties.Name="{Binding Title}"
                              Command="{Binding $parent[ItemsControl].((vm:MarkupViewModel)DataContext).SetShapeCommand}" CommandParameter="{Binding}">
                        <c:Icon Data="{Binding Icon}" Width="18" Height="18" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Width="26" Height="26" CornerRadius="6" Margin="6,0,0,0" Background="{DynamicResource HoverBrush}">
                  <c:Icon Data="{Binding ShapeIcon}" Width="18" Height="18" Foreground="{Binding CommentBrush}" StrokeThickness="2.4" />
                </Border>
                <Rectangle Classes="vsep" />
                <ItemsControl ItemsSource="{Binding CommentColors}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ColorSwatch">
                      <Button Classes="swatch" Background="{Binding Brush}" ToolTip.Tip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}"
                              Command="{Binding $parent[ItemsControl].((vm:MarkupViewModel)DataContext).SetCommentColorCommand}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Rectangle Classes="vsep" />
                <TextBlock Classes="label" Text="{l:Tr AttachTo}" />
                <RadioButton GroupName="anchor" Content="{l:Tr FirstWord}" IsChecked="{Binding OnFirstWord}" Margin="0,0,8,0" />
                <RadioButton GroupName="anchor" Content="{l:Tr LastWord}" IsChecked="{Binding OnLastWord}" />
              </StackPanel>

              <!-- Draw / text: color, transparency, thickness, size -->
              <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowDrawOptions}" VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding DrawColors}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ColorSwatch">
                      <Button Classes="swatch" Background="{Binding Brush}" ToolTip.Tip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}"
                              Command="{Binding $parent[ItemsControl].((vm:MarkupViewModel)DataContext).SetDrawColorCommand}" CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Width="26" Height="18" CornerRadius="3" Margin="6,0,0,0" Background="{Binding DrawPreview}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" />
                <Rectangle Classes="vsep" />
                <TextBlock Classes="label" Text="{l:Tr Transparency}" />
                <Slider Width="90" Minimum="0" Maximum="90" Value="{Binding DrawTransparency}" VerticalAlignment="Center" AutomationProperties.Name="{l:Tr Transparency}" />
                <TextBlock Classes="value" Text="{Binding DrawTransparency, StringFormat='{}{0:0}%'}" />
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowThickness}">
                  <TextBlock Classes="label" Text="{l:Tr Thickness}" Margin="10,0,8,0" />
                  <Slider Width="90" Minimum="0.5" Maximum="16" Value="{Binding DrawThickness}" VerticalAlignment="Center" AutomationProperties.Name="{l:Tr Thickness}" />
                  <TextBlock Classes="value" Text="{Binding DrawThickness, StringFormat='{}{0:0.#} pt'}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowTextOptions}">
                  <TextBlock Classes="label" Text="{l:Tr TextSize}" Margin="10,0,8,0" />
                  <Slider Width="90" Minimum="8" Maximum="48" Value="{Binding TextSize}" VerticalAlignment="Center" AutomationProperties.Name="{l:Tr TextSize}" />
                  <TextBlock Classes="value" Text="{Binding TextSize, StringFormat='{}{0:0} pt'}" />
                </StackPanel>
              </StackPanel>

              <!-- Stamp palette -->
              <ItemsControl IsVisible="{Binding ShowStampOptions}" ItemsSource="{Binding Stamps}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StampChoice">
                    <Button Padding="8,3" CornerRadius="5" BorderThickness="2" BorderBrush="{Binding Brush}" Background="Transparent"
                            AutomationProperties.Name="{Binding Label}"
                            Command="{Binding $parent[ItemsControl].((vm:MarkupViewModel)DataContext).SetStampCommand}" CommandParameter="{Binding}">
                      <TextBlock Text="{Binding Label}" Foreground="{Binding Brush}" FontWeight="Bold" FontSize="11" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Signature -->
              <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowSignatureOptions}" VerticalAlignment="Center" Spacing="8">
                <Button Content="{l:Tr ChangeSignature}" Command="{Binding EditSignatureCommand}" />
              </StackPanel>

              <TextBlock Classes="secondary" Text="{Binding Hint}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="420" />
            </WrapPanel>
          </Border>

          <c:PdfViewer Grid.Row="1" x:Name="Viewer" AutomationProperties.Name="{l:Tr DocumentPages}" />
        </Grid>
      </DockPanel>

      <!-- Floating toolbar lives here when undocked -->
      <Canvas x:Name="FloatLayer" />
    </Panel>
  </Grid>
</UserControl>
