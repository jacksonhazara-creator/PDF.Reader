<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PdfReader.App.ViewModels"
             xmlns:c="using:PdfReader.App.Controls"
             xmlns:l="using:PdfReader.App.Localization"
             x:Class="PdfReader.App.Views.CommandPalette"
             x:DataType="vm:MainViewModel">
  <Panel>
    <Border Classes="scrim" Opacity="0.4" PointerPressed="OnScrimPressed" />
    <Border Classes="floating" Width="560" MaxHeight="440" VerticalAlignment="Top" Margin="0,56,0,0" Padding="8">
      <Grid RowDefinitions="Auto,*" DataContext="{Binding Palette}" x:DataType="vm:CommandPaletteViewModel">
        <Panel>
          <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="{l:Tr PaletteHint}" Padding="34,8,8,8"
                   FontSize="15" KeyDown="OnQueryKeyDown" CornerRadius="6" />
          <c:Icon Data="{StaticResource IconCommand}" Width="16" Height="16" HorizontalAlignment="Left" Margin="10,0,0,0"
                  Foreground="{DynamicResource TextSecondaryBrush}" />
        </Panel>
        <Panel Grid.Row="1" Margin="0,6,0,0">
          <TextBlock Classes="secondary" Text="{l:Tr NoCommands}" Margin="10" IsVisible="{Binding HasNoResults}" />
          <ListBox x:Name="Results" Classes="plain" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedCommand}"
                   DoubleTapped="OnResultDoubleTapped" PointerReleased="OnResultReleased">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AppCommand">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <c:Icon Data="{Binding Icon}" Width="16" Height="16" Margin="2,0,12,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding GestureText}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </Grid>
    </Border>
  </Panel>
</UserControl>
