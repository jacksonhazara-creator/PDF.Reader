<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PdfReader.App.ViewModels"
        xmlns:v="using:PdfReader.App.Views"
        xmlns:c="using:PdfReader.App.Controls"
        xmlns:l="using:PdfReader.App.Localization"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="PdfReader.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PDF.Reader"
        Icon="avares://PDF.Reader/Assets/app.ico"
        Width="1180" Height="800" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ChromeBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        DragDrop.AllowDrop="True">

  <Window.Styles>
    <!-- Controls inside the custom title bar must stay clickable rather than dragging the window. -->
    <Style Selector="Border#TopBar Button, Border#TopBar ToggleButton, Border#TopBar TextBox, Border#TopBar ListBoxItem">
      <Setter Property="chrome:WindowDecorationProperties.ElementRole" Value="User" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- ===================== Top bar ===================== -->
    <Border x:Name="TopBar" Height="44" Background="{DynamicResource ChromeBrush}"
            IsVisible="{Binding IsChromeVisible}"
            chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,140">

        <Button Classes="icon" Margin="6,0,2,0" ToolTip.Tip="{l:Tr AllToolsTip}"
                Click="OnToolsClick">
          <c:Icon Data="{StaticResource IconMenu}" />
        </Button>

        <!-- Tabs -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,8,0" ClipToBounds="True">
          <ListBox Classes="tabs" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}"
                   IsVisible="{Binding HasDocuments}" VerticalAlignment="Stretch">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DocumentViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding FilePath}">
                  <c:Icon Data="{StaticResource IconFile}" Width="14" Height="14" Margin="0,0,8,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Classes="icon small" Margin="6,0,0,0" ToolTip.Tip="{l:Tr CloseTabTip}"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseDocumentCommand}"
                          CommandParameter="{Binding}">
                    <c:Icon Data="{StaticResource IconClose}" Width="12" Height="12" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Classes="icon" Margin="2,0" ToolTip.Tip="{l:Tr OpenTip}" Command="{Binding OpenDialogCommand}">
            <c:Icon Data="{StaticResource IconPlus}" Width="16" Height="16" />
          </Button>
        </StackPanel>

        <!-- Search (only with a document) -->
        <Border Grid.Column="2" IsVisible="{Binding HasDocuments}" Margin="4,0" VerticalAlignment="Center">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Width="300">
            <TextBox x:Name="SearchBox" PlaceholderText="{l:Tr SearchPlaceholder}" ToolTip.Tip="{l:Tr SearchTip}"
                     Text="{Binding ActiveDocument.SearchText, FallbackValue=''}"
                     KeyDown="OnSearchKeyDown" Padding="30,6,8,6" MinHeight="30" CornerRadius="6" />
            <c:Icon Data="{StaticResource IconSearch}" Width="15" Height="15" HorizontalAlignment="Left" Margin="9,0,0,0"
                    Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Grid.Column="1" Classes="secondary" Margin="8,0,2,0" VerticalAlignment="Center"
                       Text="{Binding ActiveDocument.SearchStatus, FallbackValue=''}" />
            <Button Grid.Column="2" Classes="icon small" ToolTip.Tip="{l:Tr PreviousResult}" Click="OnPrevHit">
              <c:Icon Data="{StaticResource IconChevronUp}" Width="15" Height="15" />
            </Button>
            <Button Grid.Column="3" Classes="icon small" ToolTip.Tip="{l:Tr NextResult}" Click="OnNextHit">
              <c:Icon Data="{StaticResource IconChevronDown}" Width="15" Height="15" />
            </Button>
            <Button Grid.Column="4" Classes="icon small" ToolTip.Tip="{l:Tr SearchOptions}">
              <TextBlock Text="Aa" FontSize="12" FontWeight="SemiBold" Margin="2,0" />
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Spacing="4" Margin="4">
                    <CheckBox Content="{l:Tr MatchCase}" IsChecked="{Binding ActiveDocument.MatchCase, FallbackValue=False}" />
                    <CheckBox Content="{l:Tr WholeWords}" IsChecked="{Binding ActiveDocument.WholeWord, FallbackValue=False}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>
        </Border>

        <!-- Page colors -->
        <Button Grid.Column="3" Classes="icon" ToolTip.Tip="{l:Tr PageColorsTip}">
          <c:Icon Data="{StaticResource IconDrop}" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="260" Spacing="12" Margin="4">
                <TextBlock Classes="subtitle" Text="{l:Tr PageColors}" />
                <UniformGrid Columns="4">
                  <RadioButton Classes="swatch" GroupName="pagecolor" Tag="{l:Tr ColorNormal}" IsChecked="{Binding PageModeNormal}">
                    <Border Background="White" CornerRadius="7" BorderBrush="#22000000" BorderThickness="1">
                      <TextBlock Text="Aa" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Border>
                  </RadioButton>
                  <RadioButton Classes="swatch" GroupName="pagecolor" Tag="{l:Tr ColorDark}" IsChecked="{Binding PageModeDark}">
                    <Border Background="#1F1F1F" CornerRadius="7">
                      <TextBlock Text="Aa" Foreground="#DADADA" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Border>
                  </RadioButton>
                  <RadioButton Classes="swatch" GroupName="pagecolor" Tag="{l:Tr ColorSepia}" IsChecked="{Binding PageModeSepia}">
                    <Border Background="#F4ECD8" CornerRadius="7">
                      <TextBlock Text="Aa" Foreground="#5B4636" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Border>
                  </RadioButton>
                  <RadioButton Classes="swatch" GroupName="pagecolor" Tag="{l:Tr ColorCustom}" IsChecked="{Binding PageModeCustom}">
                    <Border Background="{Binding CustomPageBackground}" CornerRadius="7">
                      <TextBlock Text="Aa" Foreground="{Binding CustomPageForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Border>
                  </RadioButton>
                </UniformGrid>
                <ToggleSwitch Content="{l:Tr KeepImagesNatural}" IsChecked="{Binding KeepImagesNatural}" OnContent="" OffContent="" />
                <ToggleSwitch Content="{l:Tr OnlyThisDocument}" IsChecked="{Binding PageColorsOnlyThisDocument}"
                              IsEnabled="{Binding HasDocuments}" OnContent="" OffContent="" />
                <TextBlock Classes="secondary" Text="{l:Tr PageColorsNote}" TextWrapping="Wrap" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <Button Grid.Column="4" Classes="icon" Margin="2,0,0,0" ToolTip.Tip="{l:Tr SettingsTip}" Click="OnSettingsClick">
          <c:Icon Data="{StaticResource IconSettings}" />
        </Button>
      </Grid>
    </Border>

    <!-- ===================== Content ===================== -->
    <Panel Grid.Row="1">
      <v:StartView IsVisible="{Binding !HasDocuments}" />

      <ContentControl Content="{Binding ActiveDocument}" IsVisible="{Binding HasDocuments}">
        <ContentControl.DataTemplates>
          <DataTemplate x:DataType="vm:DocumentViewModel">
            <v:DocumentView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>

      <!-- Transient status pills -->
      <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,76" Spacing="8">
        <Border Classes="floating" Padding="14,8" IsVisible="{Binding ReadAloud.IsSpeaking}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <c:Icon Data="{StaticResource IconSpeaker}" Foreground="{DynamicResource SystemAccentColor}" />
            <TextBlock Text="{l:Tr ReadingAloud}" VerticalAlignment="Center" />
            <Button Classes="popup" Padding="8,3" Click="OnStopReading">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{StaticResource IconStop}" Width="14" Height="14" />
                <TextBlock Text="{l:Tr Stop}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
        <Border Classes="floating" Padding="14,8" IsVisible="{Binding ProgressText, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ProgressBar IsIndeterminate="True" Width="80" MinWidth="80" />
            <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border Classes="floating" Padding="14,8" IsVisible="{Binding Toast, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding Toast}" />
        </Border>
      </StackPanel>

      <v:ToolsPanel IsVisible="{Binding IsToolsPanelOpen}" />
      <Panel IsVisible="{Binding IsSettingsOpen}"><v:SettingsView DataContext="{Binding SettingsPage}" /></Panel>
      <v:CommandPalette IsVisible="{Binding IsCommandPaletteOpen}" />
      <Panel IsVisible="{Binding Dialog, Converter={x:Static ObjectConverters.IsNotNull}}"><v:DialogView DataContext="{Binding Dialog}" /></Panel>
    </Panel>
  </Grid>
</Window>
