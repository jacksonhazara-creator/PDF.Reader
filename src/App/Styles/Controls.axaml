<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:PdfReader.App.Controls">

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Inter" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- Icon buttons: transparent, rounded, subtle hover -->
  <Style Selector="Button.icon, ToggleButton.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
  </Style>
  <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
  </Style>
  <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="Padding" Value="4" />
  </Style>

  <!-- Buttons inside floating popups -->
  <Style Selector="Button.popup">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.popup:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- List-like row buttons (tools panel, palette, menus) -->
  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Accent call-to-action -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="Padding" Value="18,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Floating surfaces -->
  <Style Selector="Border.floating">
    <Setter Property="Background" Value="{DynamicResource FloatingBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource OverlayRadius}" />
    <Setter Property="BoxShadow" Value="{StaticResource FloatingShadow}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource OverlayRadius}" />
  </Style>
  <Style Selector="Border.scrim">
    <Setter Property="Background" Value="{DynamicResource ScrimBrush}" />
  </Style>

  <!-- Overlays fade in quickly and never block input while hidden -->
  <Style Selector=":is(Control).fade">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Document tabs -->
  <Style Selector="ListBox.tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="Padding" Value="12,0,4,0" />
    <Setter Property="Margin" Value="0,6,2,0" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="MaxWidth" Value="220" />
    <Setter Property="CornerRadius" Value="8,8,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="8,8,0,0" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.tabs ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ViewerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Plain lists (thumbnails, palette results): no heavy selection chrome -->
  <Style Selector="ListBox.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem">
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
  </Style>

  <!-- Settings navigation -->
  <Style Selector="RadioButton.nav">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:checked">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Segmented control (sidebar tabs) -->
  <Style Selector="RadioButton.segment">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" Background="Transparent" CornerRadius="5" Padding="6,5">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.segment:pointerover /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="RadioButton.segment:checked /template/ Border#bg">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BoxShadow" Value="{StaticResource SoftShadow}" />
  </Style>

  <!-- Page color swatches in the flyout -->
  <Style Selector="RadioButton.swatch">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="4" HorizontalAlignment="Center">
          <Border Name="ring" Width="46" Height="46" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" Padding="2">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
          <TextBlock Text="{TemplateBinding Tag}" HorizontalAlignment="Center" FontSize="12" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.swatch:pointerover /template/ Border#ring">
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
  </Style>
  <Style Selector="RadioButton.swatch:checked /template/ Border#ring">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
  </Style>

  <!-- Tool bar -->
  <Style Selector="Border.toolbar.docked">
    <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
  </Style>
  <Style Selector="Border.toolbar.floating">
    <Setter Property="Background" Value="{DynamicResource FloatingBrush}" />
  </Style>
  <Style Selector="Rectangle.toolsep">
    <Setter Property="Fill" Value="{DynamicResource SubtleBorderBrush}" />
  </Style>
  <Style Selector="Button.toolgroup">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.toolgroup:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.toolgroup:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.row:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.toolgroup.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="Button.toolgroup.active c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
  </Style>
  <Style Selector="Button.toolgroup.active TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="c|Icon">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button:disabled c|Icon, ToggleButton:disabled c|Icon">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
</Styles>
