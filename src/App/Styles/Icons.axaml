<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Icons: Segoe Fluent Icons glyphs (built into Windows 11; Segoe MDL2 Assets fallback on Windows 10) for a crisp,
       native look. The few shapes the font lacks are 24x24 line drawings stroked by Controls/Icon.cs. -->
