  <x:String x:Key="IconComment">&#xE90A;</x:String>
  <x:String x:Key="IconTrash">&#xE74D;</x:String>
  <x:String x:Key="ShapeSquare">&#xE739;</x:String>
  <x:String x:Key="ShapeCircle">&#xEA3A;</x:String>
  <x:String x:Key="ShapeCloud">&#xE753;</x:String>
  <x:String x:Key="ShapeBubble">&#xE8BD;</x:String>
  <x:String x:Key="ShapeStar">&#xE734;</x:String>
  <x:String x:Key="IconPan">&#xE7C9;</x:String>
  <x:String x:Key="IconReplace">&#xE8AB;</x:String>
  <StreamGeometry x:Key="IconInsert">M5,20 L12,6 L19,20 M4,4 H20</StreamGeometry>
  <x:String x:Key="IconTextComment">&#xE8BD;</x:String>
