  <x:String x:Key="IconSearch">&#xE721;</x:String>
  <x:String x:Key="IconSettings">&#xE713;</x:String>
  <x:String x:Key="IconDrop">&#xE793;</x:String>
  <x:String x:Key="IconClose">&#xE711;</x:String>
  <x:String x:Key="IconPlus">&#xE710;</x:String>
  <x:String x:Key="IconMinus">&#xE738;</x:String>
  <x:String x:Key="IconFolder">&#xE838;</x:String>
  <x:String x:Key="IconFile">&#xE7C3;</x:String>
  <x:String x:Key="IconGrid">&#xF0E2;</x:String>
  <x:String x:Key="IconList">&#xE8FD;</x:String>
  <x:String x:Key="IconSidebar">&#xE8A0;</x:String>
  <x:String x:Key="IconPrint">&#xE749;</x:String>
  <x:String x:Key="IconSpeaker">&#xE767;</x:String>
  <x:String x:Key="IconStop">&#xE71A;</x:String>
