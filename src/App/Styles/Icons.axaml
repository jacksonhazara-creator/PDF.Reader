  <x:String x:Key="IconActualSize">&#xE740;</x:String>
  <x:String x:Key="IconCommand">&#xE765;</x:String>
  <x:String x:Key="IconShield">&#xEA18;</x:String>
  <x:String x:Key="IconRefresh">&#xE72C;</x:String>
  <x:String x:Key="IconArrowRight">&#xE72A;</x:String>
  <x:String x:Key="IconArrowUp">&#xE74A;</x:String>
  <x:String x:Key="IconArrowDown">&#xE74B;</x:String>
